# Webhook Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to the repository

# Secret key for GitHub webhook signature verification
# Use the same value in GitHub repo → Settings → Webhooks → Secret
WEBHOOK_SECRET=your-secret-here-change-this

# Absolute path to the site root on the server
DEPLOY_PATH=/home/your-site-user/htdocs/your-domain.com
